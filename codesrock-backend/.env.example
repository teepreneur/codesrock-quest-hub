# Server Configuration
PORT=5001
NODE_ENV=development

# Supabase (Project Settings -> API). The service key must stay server-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Extra CORS origins, comma separated (localhost, portal.codesrock.com and
# teepreneur.github.io are always allowed)
ALLOWED_ORIGINS=

# Cloudinary (resource uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Legacy JWT settings (only used by src/utils/jwt.ts)
JWT_SECRET=change-this-in-production
JWT_EXPIRE=7d
